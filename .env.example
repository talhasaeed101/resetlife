# Public site URL used for metadata, sitemap, and robots.txt
NEXT_PUBLIC_SITE_URL=https://resetlifefarmhouse.com

# Destination inbox for contact and booking inquiries
CONTACT_FORM_TO_EMAIL=resetlifefarmhouse@gmail.com

# Verified sender domain/email for Resend (required when RESEND_API_KEY is set)
CONTACT_FORM_FROM_EMAIL=Reset Life <noreply@your-domain.com>

# Optional: enables /api/inquiry email delivery via Resend
# RESEND_API_KEY=
